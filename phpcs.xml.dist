<?xml version="1.0"?>
<ruleset name="PV Blocks Suite">
    <description>WPCS ruleset for the PV Blocks Suite plugin.</description>

    <file>.</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/docs/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <rule ref="WordPress-Extra"/>

    <rule ref="WordPress.Files.FileName">
        <properties>
            <property name="is_theme" value="false"/>
        </properties>
    </rule>

    <config name="minimum_supported_wp_version" value="6.5"/>

    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude-pattern>/src/*</exclude-pattern>
    </rule>

    <!--
    This project targets PHP 8.2+ with a modern style (see CLAUDE.md), so the
    two purely-stylistic sniffs below are turned off in favor of native short
    array syntax `[]` and short ternaries `?:`. Everything else in
    WordPress-Extra (escaping, nonces, i18n, naming, security) stays active.
    -->
    <rule ref="Universal.Arrays.DisallowShortArraySyntax.Found">
        <severity>0</severity>
    </rule>
    <rule ref="Universal.Operators.DisallowShortTernary.Found">
        <severity>0</severity>
    </rule>
</ruleset>
