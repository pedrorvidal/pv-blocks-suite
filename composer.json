{
    "name": "pv/pv-blocks-suite",
    "description": "A suite of Gutenberg blocks for WordPress content creators.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Pedro Vidal"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PV\\BlocksSuite\\": "src/"
        },
        "classmap": [
            "includes/"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
