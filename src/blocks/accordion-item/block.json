{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "pv-blocks-suite/accordion-item",
    "title": "Accordion Item",
    "category": "pv-blocks-suite",
    "icon": "arrow-down-alt2",
    "description": "A single collapsible item within an Accordion block.",
    "keywords": ["accordion", "faq", "item"],
    "textdomain": "pv-blocks-suite",
    "parent": ["pv-blocks-suite/accordion"],
    "attributes": {
        "summary": {
            "type": "string",
            "default": ""
        },
        "headingLevel": {
            "type": "number",
            "default": 3
        },
        "openByDefault": {
            "type": "boolean",
            "default": false
        }
    },
    "usesContext": [
        "pv-blocks-suite/accordionGroupId",
        "pv-blocks-suite/accordionAllowMultipleOpen"
    ],
    "example": {
        "attributes": {
            "summary": "What is included?"
        },
        "innerBlocks": [
            {
                "name": "core/paragraph",
                "attributes": { "content": "Everything you need to get started." }
            }
        ]
    },
    "supports": {
        "html": false,
        "anchor": true
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
}
